<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.PIIIProjectGUI.GUI.GUIControllers.PlayerStatsController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Character Stats" style="-fx-font-size:18; -fx-font-weight:bold;" />

    <GridPane hgap="10" vgap="8">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="nameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Health:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="healthLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Damage Multiplier:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="damageMultiplierLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Alive:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="aliveLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Equipped Weapon:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="equippedWeaponLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Total Damage:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="totalDamageLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="OK" onAction="#onClose"/>
</VBox>
