<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.PIIIProjectGUI.controllers.RegisterController">

    <VBox spacing="10.0" fillWidth="true">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Register New User" style="-fx-font-size: 18px; -fx-font-weight: bold"/>

        <Label text="Email:"/>
        <TextField fx:id="emailField" maxWidth="Infinity"/>

        <Label text="Password:"/>
        <PasswordField fx:id="passwordField" maxWidth="Infinity"/>

        <Label text="Role:"/>
        <ComboBox fx:id="roleComboBox" promptText="Select a role" maxWidth="Infinity"/>

        <Button text="Register" onAction="#handleRegister" maxWidth="Infinity"/>
        <Button text="Go to Login" onAction="#switchToLogin" maxWidth="Infinity"/>

        <Label fx:id="messageLabel" style="-fx-text-fill: red"/>
    </VBox>
</ScrollPane>
